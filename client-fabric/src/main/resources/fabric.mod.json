{
  "schemaVersion": 1,
  "id": "voicechat_group_tools_client",
  "version": "${version}",
  "name": "Voice Chat Group Tools Client",
  "description": "Adds Vanilla Game group actions and current-leader status to the Simple Voice Chat group screen.",
  "authors": [
    "Vanilla Game"
  ],
  "contact": {
    "homepage": "https://vanilla-game.ru",
    "sources": "https://github.com/Vanilla-Game/voicechat-group-tools"
  },
  "license": "All-Rights-Reserved",
  "environment": "client",
  "entrypoints": {
    "client": [
      "ru.vanillagame.voicechat.grouptools.client.VoiceChatGroupToolsClient"
    ]
  },
  "mixins": [
    "voicechat-group-tools-client.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "fabric-api": ">=${fabric_api_version}",
    "java": ">=25",
    "minecraft": "${minecraft_version}",
    "voicechat": "${voicechat_range}"
  }
}
