{
  "schemaVersion": 1,
  "id": "svc_better_groups_client",
  "version": "${version}",
  "name": "Simple Voice Chat Better Groups (Client)",
  "description": "Adds Vanilla Game group actions and current-leader status to the Simple Voice Chat group screen.",
  "authors": [
    "Vanilla Game"
  ],
  "contact": {
    "homepage": "https://vanilla-game.ru",
    "sources": "https://github.com/Vanilla-Game/simple-voice-chat-better-groups"
  },
  "license": "All-Rights-Reserved",
  "environment": "client",
  "entrypoints": {
    "client": [
      "ru.vanillagame.voicechat.bettergroups.client.BetterGroupsClient"
    ]
  },
  "mixins": [
    "svc-better-groups-client.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "fabric-api": ">=${fabric_api_version}",
    "java": ">=25",
    "minecraft": "${minecraft_version}",
    "voicechat": "${voicechat_range}"
  }
}
