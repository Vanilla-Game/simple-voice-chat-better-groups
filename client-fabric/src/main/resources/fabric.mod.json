{
  "schemaVersion": 1,
  "id": "svc_group_management_client",
  "version": "${version}",
  "name": "Simple Voice Chat Group Management (Client)",
  "description": "Adds Vanilla Game group actions and current-leader status to the Simple Voice Chat group screen.",
  "authors": [
    "Vanilla Game"
  ],
  "contact": {
    "homepage": "https://vanilla-game.ru",
    "sources": "https://github.com/Vanilla-Game/simple-voice-chat-group-management"
  },
  "license": "All-Rights-Reserved",
  "environment": "client",
  "entrypoints": {
    "client": [
      "ru.vanillagame.voicechat.groupmanagement.client.SvcGroupManagementClient"
    ]
  },
  "mixins": [
    "svc-group-management-client.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "fabric-api": ">=${fabric_api_version}",
    "java": ">=25",
    "minecraft": "${minecraft_version}",
    "voicechat": "${voicechat_range}"
  }
}
